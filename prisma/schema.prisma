generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Media {
  id                 String   @id @default(cuid())
  cloudinaryPublicId String   @unique
  s3Key              String?
  title              String
  description        String?
  category           String
  type               String
  tags               String
  role               String?
  views              Int      @default(0)
  createdAt          DateTime @default(now())
}
